  "records": [
    {
      "assertionType": "controlled-receiver-protocol",
      "blockedReason": "controlled HTTPS receiver, isolated DNS/egress allowlist, and operator-owned webhook credential are later prerequisites; no receiver or secret is materialized.",
      "evidenceLevel": "E2",
      "expected": {
        "noSecretInCorpus": true,
        "receiverOutcomes": [
          "2xx acknowledge",
          "429 retry",
          "500 retry",
          "401 pause",
          "410 disable"
        ],
        "requestHeaders": [
          "SmartForms-Event-Id",
          "SmartForms-Key-Id",
          "SmartForms-Signature"
        ],
        "signatureInput": "timestamp + \".\" + eventId + \".\" + rawRequestBody UTF-8"
      },
      "expectedSource": "prd",
      "fixtures": [
        "T19"
      ],
      "id": "EVAL-T19-WEBHOOK-01",
      "milestoneGates": [
        "M0",
