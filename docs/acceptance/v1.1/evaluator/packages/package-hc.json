        }
      ],
      "op": "eq"
    },
    "requiresTrue": {
      "args": [
        {
          "path": "$current"
        },
        {
          "literal": true
        }
      ],
      "op": "eq"
    },
    "safetyConcernPresent": {
      "args": [
        {
          "path": "/answers/hc-f29"
