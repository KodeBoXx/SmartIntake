    "modeSelectionValid": {
      "op": "choiceFromOptionSet",
      "path": "$current"
    },
    "neverRequired": {
      "op": "literal",
      "value": false
    },
    "nonBlankText": {
      "op": "trimmedNonEmpty",
      "path": "$current"
    },
    "pastDate": {
      "args": [
        {
          "path": "$current"
        },
        {
          "literal": "2026-09-14"
        }
      ],
      "op": "lt"
    },
    "pregnancyCareApplies": {
      "args": [
        {
          "path": "/answers/hc-f13"
        },
        {
          "literal": true
        }
      ],
      "op": "eq"
    },
    "referralRequired": {
      "args": [
        {
          "path": "/answers/hc-f22"
