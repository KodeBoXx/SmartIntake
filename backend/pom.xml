<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion><parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.4.4</version></parent>
  <groupId>com.kodeboxx</groupId><artifactId>smartintake-api</artifactId><version>1.1.0</version><name>smartintake-api</name>
  <properties><java.version>17</java.version><json.schema.validator.version>1.5.6</json.schema.validator.version><openapi.generator.version>7.10.0</openapi.generator.version><openapi.contract.input>${project.basedir}/../tools/contracts/openapi-java-models.yaml</openapi.contract.input><openapi.contract.output>${project.basedir}/src/generated/java</openapi.contract.output></properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-crypto</artifactId></dependency>
    <dependency><groupId>com.networknt</groupId><artifactId>json-schema-validator</artifactId><version>${json.schema.validator.version}</version></dependency>
    <dependency><groupId>org.openapitools</groupId><artifactId>jackson-databind-nullable</artifactId><version>0.2.6</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies><build><plugins>
    <plugin><groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.0</version><executions><execution><id>add-checked-in-contract-models</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals><configuration><sources><source>${project.basedir}/src/generated/java</source></sources></configuration></execution></executions></plugin>
    <plugin><groupId>org.openapitools</groupId><artifactId>openapi-generator-maven-plugin</artifactId><version>${openapi.generator.version}</version><executions><execution><id>generate-checked-in-contract-models</id><phase>generate-sources</phase><goals><goal>generate</goal></goals><configuration><inputSpec>${openapi.contract.input}</inputSpec><generatorName>java</generatorName><library>resttemplate</library><output>${openapi.contract.output}</output><modelPackage>com.kodeboxx.smartintake.generated.contract</modelPackage><apiPackage>com.kodeboxx.smartintake.generated.contract.api</apiPackage><generateApis>false</generateApis><generateModelTests>false</generateModelTests><generateModelDocumentation>false</generateModelDocumentation><generateSupportingFiles>false</generateSupportingFiles><configOptions><sourceFolder>.</sourceFolder><useJakartaEe>true</useJakartaEe><serializationLibrary>jackson</serializationLibrary><hideGenerationTimestamp>true</hideGenerationTimestamp></configOptions><additionalProperties><dateLibrary>java8</dateLibrary></additionalProperties></configuration></execution></executions></plugin>
    <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version><executions>
      <execution><id>check-generated-contract-artifacts</id><phase>validate</phase><goals><goal>exec</goal></goals><configuration><workingDirectory>${project.basedir}</workingDirectory><executable>python3</executable><arguments><argument>../tools/contracts/generate_contract_artifacts.py</argument><argument>--check</argument><argument>--scope</argument><argument>backend</argument></arguments></configuration></execution>
      <execution><id>validate-draft-2020-12-contracts</id><phase>validate</phase><goals><goal>exec</goal></goals><configuration><workingDirectory>${project.basedir}</workingDirectory><executable>python3</executable><arguments><argument>../tools/contracts/validate_schemas.py</argument></arguments></configuration></execution>
      <execution><id>validate-openapi-contract-inventory</id><phase>validate</phase><goals><goal>exec</goal></goals><configuration><workingDirectory>${project.basedir}</workingDirectory><executable>python3</executable><arguments><argument>../tools/openapi/validate_openapi.py</argument><argument>--check-generated</argument></arguments></configuration></execution>
    </executions></plugin>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version><executions><execution><id>require-reproducible-build-toolchain</id><goals><goal>enforce</goal></goals><configuration><rules><requireJavaVersion><version>[17,18)</version></requireJavaVersion><requireMavenVersion><version>[3.8.7,)</version></requireMavenVersion></rules></configuration></execution></executions></plugin>
  </plugins></build>
</project>
