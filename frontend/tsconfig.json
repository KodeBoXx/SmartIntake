{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "outDir": "./dist/out-tsc",
    "baseUrl": ".",
    "paths": {
      "@certinal/ui": [
        "projects/certinal-ui/src/public-api.ts"
      ]
