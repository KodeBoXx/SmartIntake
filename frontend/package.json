{
  "name": "smart-intake-web",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "contracts:check": "python3 ../tools/contracts/generate_contract_artifacts.py --check --scope frontend && python3 ../tools/contracts/validate_schemas.py && python3 ../tools/openapi/validate_openapi.py --check-generated",
    "prebuild": "npm run contracts:check",
    "pretest": "npm run contracts:check",
    "start": "ng serve --host 0.0.0.0 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "ng test --watch=false"
  },
  "dependencies": {
    "@angular/animations": "^20.2.0",
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",
    "ajv": "8.18.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/compiler-cli": "^20.2.0",
    "ajv-formats": "3.0.1",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "15.0.4",
    "openapi-typescript": "7.6.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.7"
  }
}
